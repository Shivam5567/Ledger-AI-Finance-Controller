# ─────────────────────────────────────────────────────────────
# Ledger AI — Server Configuration Template
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# Get your free API key at: https://aistudio.google.com/app/apikey
# Keys look like: AIzaSyB...  (starts with "AIza")
# Without a key, the app runs in local-AI mode (no API calls).
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use. Free-tier options (20 req/day each):
#   gemini-2.0-flash        ← recommended
#   gemini-1.5-flash        ← alternative  
#   gemini-1.5-flash-8b     ← lightest / fastest
GEMINI_MODEL=gemini-2.0-flash

PORT=3001
