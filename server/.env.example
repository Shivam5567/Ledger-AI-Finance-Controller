# ─────────────────────────────────────────────────────────────
# Ledger AI — Server Configuration Template
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Server port (Railway sets this automatically)
PORT=3001

# Database path (optional, defaults to ./ledger.db)
# DB_PATH=/data/ledger.db

# Sample CSV path (optional)
# CSV_PATH=/app/sample_transactions.csv

# Allowed CORS origins (comma-separated, optional)
# ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Razorpay Webhook Secret for HMAC-SHA256 verification (optional in sandbox)
# RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
